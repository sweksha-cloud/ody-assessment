{
  "name": "odyssey-dashboard",
  "private": true,
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=@odyssey/dashboard",
    "dev:backend": "turbo run dev --filter=@odyssey/backend",
    "gen:contract": "turbo run gen:contract --filter=@odyssey/backend && turbo run gen:contract --filter=@odyssey/api-client",
    "db:migrate": "pnpm --filter @odyssey/backend db:migrate",
    "db:seed": "pnpm --filter @odyssey/backend db:seed",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "volta": {
    "node": "20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@scarf/scarf"
    ]
  }
}
