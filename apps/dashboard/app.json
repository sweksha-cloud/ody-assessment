{
  "expo": {
    "name": "ServiceLine",
    "description": "ServiceLine — Restaurant Operations: manage live orders, menus, customers, business settings, and daily performance.",
    "slug": "odyssey-dashboard",
    "scheme": "odyssey-dashboard",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "themeColor": "#11152B",
      "backgroundColor": "#F3F5FA"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {}
  }
}
